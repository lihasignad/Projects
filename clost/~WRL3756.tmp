<td>Vendor acceptance rate</td>
<td>≥ 85%</td>
</tr>
<tr>
<td>Average delivery time</td>
<td>≤ 35 minutes</td>
</tr>
<tr>
<td>Customer repeat rate (30-day)</td>
<td>≥ 15%</td>
</tr>
<tr>
<td>Return rate</td>
<td>≤ 18%</td>
</tr>
</tbody></table>
